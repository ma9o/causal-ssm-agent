# =============================================================================
# Production Environment
# =============================================================================
# This file documents the runtime environment variables expected by production.
# It is not loaded automatically anywhere.
#
# Production topology: the interactive service (Temporal + worker + tool
# server) runs wherever episodes are driven — typically locally, next to the
# agent. Hosting is read-only: a Modal ASGI read facade over the R2 store plus
# the Vercel viewer. Workspaces reach the hosted store via `nof1-publish`.
#
# Set these separately in each runtime:
# - Modal secret block `nof1-causal-lab-pipeline-secrets` (stage runners + read facade)
# - Vercel project environment variables (viewer)

# ---------------------------------------------------------------------------
# Modal secret block — stage runners (stage-4/5b compute) + read facade
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
GOOGLE_CLOUD_PROJECT=nof1-causal-lab
GOOGLE_CLOUD_LOCATION=global
EXA_API_KEY=
DEPLOYMENT_ENV=production
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=data

# Google Cloud auth (service account, not gcloud CLI)
#GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ---------------------------------------------------------------------------
# Vercel (viewer) — no secrets beyond storage reads; readOnly comes from the
# facade's /api/capabilities at runtime
# ---------------------------------------------------------------------------
# URL of the Modal read facade deployment
TOOL_SERVER_URL=
DEPLOYMENT_ENV=production
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=data

# ---------------------------------------------------------------------------
# CI/CD — deployment auth (GitHub Actions / hosting secrets, never in app env)
# ---------------------------------------------------------------------------
#MODAL_TOKEN_ID=
#MODAL_TOKEN_SECRET=
#VERCEL_TOKEN=
#VERCEL_ORG_ID=
#VERCEL_PROJECT_ID=
