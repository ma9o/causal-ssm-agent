# =============================================================================
# Production Environment
# =============================================================================
# For Modal functions, store these in the "causal-ssm-pipeline-secrets" block.
# For CI/CD, set MODAL_TOKEN_* as GitHub Actions repository secrets.
# For the web app, set these in your hosting provider's env config.

# ---------------------------------------------------------------------------
# LLM API Keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
GOOGLE_CLOUD_PROJECT=causal-agent
GOOGLE_CLOUD_LOCATION=global
EXA_API_KEY=

# Google Cloud auth (service account, not gcloud CLI)
#GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ---------------------------------------------------------------------------
# Deployment — switches stages 2, 4, 5b to Modal runners
# ---------------------------------------------------------------------------
DEPLOYMENT_ENV=production

# ---------------------------------------------------------------------------
# Storage — Cloudflare R2 (used by both data pipeline and web app)
# ---------------------------------------------------------------------------
STORAGE_BACKEND=r2
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=data

# ---------------------------------------------------------------------------
# Web App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://your-production-url.com
TOOL_SERVER_URL=https://your-tool-server-url.com

# ---------------------------------------------------------------------------
# CI/CD — GitHub Actions secrets (not in .env, set via repo settings)
# ---------------------------------------------------------------------------
#MODAL_TOKEN_ID=
#MODAL_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Future: Prefect Cloud (when flow deployments are added)
# ---------------------------------------------------------------------------
#PREFECT_API_KEY=
#PREFECT_API_URL=
