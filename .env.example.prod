# =============================================================================
# Production Environment
# =============================================================================
# This file documents the runtime environment variables expected by production.
# It is not loaded automatically anywhere.
#
# Set these separately in each runtime:
# - Modal secret block `causal-ssm-pipeline-secrets` for the data pipeline
# - Vercel project environment variables for the web app
# - Any Prefect host / reverse proxy environment where applicable

# ---------------------------------------------------------------------------
# LLM API Keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_SESSION_SECRET=
BYOK_SECRET_STORE_ENCRYPTION_KEY=
#BYOK_SECRET_STORE_URL=libsql://your-byok-store.turso.io
#BYOK_SECRET_STORE_AUTH_TOKEN=
OPENROUTER_TRIAL_API_KEY=
OPENROUTER_CREDITS_API_KEY=
GOOGLE_CLOUD_PROJECT=causal-agent
GOOGLE_CLOUD_LOCATION=global
EXA_API_KEY=

# Google Cloud auth (service account, not gcloud CLI)
#GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ---------------------------------------------------------------------------
# Deployment — switches stages 2, 4, 5b to Modal runners
# ---------------------------------------------------------------------------
DEPLOYMENT_ENV=production

# ---------------------------------------------------------------------------
# Storage — Cloudflare R2 (used by both data pipeline and web app)
# ---------------------------------------------------------------------------
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=data

# ---------------------------------------------------------------------------
# Web-to-Prefect / refinement wiring
# ---------------------------------------------------------------------------
PREFECT_API_URL=
TOOL_SERVER_URL=
NEXT_PUBLIC_PREFECT_EVENTS_URL=

# ---------------------------------------------------------------------------
# CI/CD — deployment auth (GitHub Actions / hosting secrets, never in app env)
# ---------------------------------------------------------------------------
#MODAL_TOKEN_ID=
#MODAL_TOKEN_SECRET=
#VERCEL_TOKEN=
#VERCEL_ORG_ID=
#VERCEL_PROJECT_ID=

# ---------------------------------------------------------------------------
# Future: Prefect Cloud (when flow deployments are added)
# ---------------------------------------------------------------------------
#PREFECT_API_KEY=
