{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": [
    ".",
    "apps/data-pipeline",
    "packages/api-types",
    "packages/typescript-config"
  ],
  "workspaces": {
    "apps/web": {
      "ignoreExportsUsedInFile": true,
      "project": [
        "src/**/*.{ts,tsx}!",
        "!src/**/*.stories.tsx",
        "!src/**/*.test.{ts,tsx}",
        "!src/**/__fixtures__/**",
        "!src/components/design-prototypes/**",
        "!src/**/story-decorators.tsx",
        "!src/**/stage-story-*.{ts,tsx}",
        "!src/components/pipeline/output-story-helpers.tsx",
        "!src/components/pipeline/output-story-template.tsx",
        "!src/integration/**"
      ],
      "ignoreDependencies": ["@tailwindcss/typography", "shadcn", "tailwindcss", "tw-animate-css"]
    }
  }
}
