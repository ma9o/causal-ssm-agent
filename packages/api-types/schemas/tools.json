{
  "stage-0": [
    {
      "name": "list_files",
      "description": "List files in the prepared input directory.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "default": ".",
            "description": "Relative path within the input directory.",
            "title": "Path",
            "type": "string"
          }
        },
        "title": "ListFilesInput",
        "type": "object"
      },
      "result": null
    },
    {
      "name": "read_file_sample",
      "description": "Read a sample of lines from a file to understand its format.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Relative path to the file within the input directory.",
            "title": "Path",
            "type": "string"
          },
          "n_lines": {
            "default": 50,
            "description": "Number of lines to read.",
            "title": "N Lines",
            "type": "integer"
          }
        },
        "required": [
          "path"
        ],
        "title": "ReadFileSampleInput",
        "type": "object"
      },
      "result": null
    },
    {
      "name": "execute_python",
      "description": "Execute Python code in a Modal sandbox to parse files into a Polars DataFrame.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Python code to execute.",
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "ExecutePythonInput",
        "type": "object"
      },
      "result": null
    },
    {
      "name": "submit_table",
      "description": "Validate and finalize the ingested DataFrame with column descriptions.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "column_descriptions_json": {
            "description": "JSON object mapping column names to descriptions.",
            "title": "Column Descriptions Json",
            "type": "string"
          }
        },
        "required": [
          "column_descriptions_json"
        ],
        "title": "SubmitTableInput",
        "type": "object"
      },
      "result": null
    }
  ],
  "stage-1a": [
    {
      "name": "validate_latent_model",
      "description": "Tool for validating latent model JSON (Stage 1a).",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "structure_json": {
            "description": "The JSON string containing the latent model to validate.",
            "title": "Structure Json",
            "type": "string"
          }
        },
        "required": [
          "structure_json"
        ],
        "title": "ValidateLatentModelInput",
        "type": "object"
      },
      "result": null
    }
  ],
  "stage-1b": [
    {
      "name": "validate_measurement_model",
      "description": "Validate measurement model JSON, check compiler constraints, and verify causal identifiability.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "measurement_json": {
            "description": "The JSON string containing the measurement model to validate.",
            "title": "Measurement Json",
            "type": "string"
          }
        },
        "required": [
          "measurement_json"
        ],
        "title": "ValidateMeasurementModelInput",
        "type": "object"
      },
      "result": null
    }
  ],
  "stage-2": [
    {
      "name": "validate_extractions",
      "description": "Tool for validating worker extraction output JSON.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "output_json": {
            "description": "The JSON string containing the worker output to validate.",
            "title": "Output Json",
            "type": "string"
          }
        },
        "required": [
          "output_json"
        ],
        "title": "ValidateExtractionsInput",
        "type": "object"
      },
      "result": null
    }
  ],
  "stage-4": [
    {
      "name": "search_literature",
      "description": "Search for empirical literature about effect sizes for model parameters.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "description": "Search query for empirical literature about effect sizes.",
            "title": "Query",
            "type": "string"
          },
          "parameter_name": {
            "description": "Name of the parameter this search is for (e.g. 'beta_stress_sleep').",
            "title": "Parameter Name",
            "type": "string"
          }
        },
        "required": [
          "query",
          "parameter_name"
        ],
        "title": "SearchLiteratureInput",
        "type": "object"
      },
      "result": null
    },
    {
      "name": "validate_model",
      "description": "Validate model specification and/or prior proposals: schema check, compile, prior predictive simulation.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "model_json": {
            "description": "JSON object with proposed changes. Include 'model_spec' (complete ModelSpec) and/or 'priors' (dict mapping parameter names to prior proposals). Only include fields you are changing.",
            "title": "Model Json",
            "type": "string"
          }
        },
        "required": [
          "model_json"
        ],
        "title": "ValidateModelInput",
        "type": "object"
      },
      "result": null
    }
  ],
  "stage-6": [
    {
      "name": "get_model_info",
      "description": "Return a read-only summary of the fitted model, variables, identifiability status, diagnostics, and stage-6 baseline effects.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "sections": {
            "description": "Named sections to include in the read-only model summary.",
            "items": {
              "enum": [
                "overview",
                "variables",
                "measurement",
                "identifiability",
                "diagnostics",
                "baseline_effects",
                "capabilities"
              ],
              "type": "string"
            },
            "title": "Sections",
            "type": "array"
          },
          "names": {
            "description": "Optional construct or indicator names to focus the summary on.",
            "items": {
              "type": "string"
            },
            "title": "Names",
            "type": "array"
          }
        },
        "title": "GetModelInfoInput",
        "type": "object"
      },
      "result": null
    },
    {
      "name": "simulate_intervention",
      "description": "Run a Pearl rung-2 interventional simulation on the fitted generative model.",
      "parameters": {
        "$defs": {
          "InterventionActionInput": {
            "additionalProperties": false,
            "properties": {
              "variable": {
                "description": "Latent construct to intervene on.",
                "title": "Variable",
                "type": "string"
              },
              "mode": {
                "description": "'set' clamps the construct to a value; 'shift' adds an amount to baseline.",
                "enum": [
                  "set",
                  "shift"
                ],
                "title": "Mode",
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Required when mode='set'. Absolute latent-space value to clamp to.",
                "title": "Value"
              },
              "amount": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Required when mode='shift'. Additive latent-space delta from baseline.",
                "title": "Amount"
              }
            },
            "required": [
              "variable",
              "mode"
            ],
            "title": "InterventionActionInput",
            "type": "object"
          },
          "InterventionQueryInput": {
            "additionalProperties": false,
            "properties": {
              "estimand": {
                "default": "steady_state",
                "description": "Steady-state effect or forward trajectory effect.",
                "enum": [
                  "steady_state",
                  "trajectory"
                ],
                "title": "Estimand",
                "type": "string"
              },
              "horizon_days": {
                "default": 30,
                "description": "Forward horizon in days when estimand='trajectory'.",
                "maximum": 365,
                "minimum": 1,
                "title": "Horizon Days",
                "type": "integer"
              },
              "projection": {
                "default": "latent",
                "description": "Whether to report latent outcome effects, manifest projections, or both.",
                "enum": [
                  "latent",
                  "manifest",
                  "both"
                ],
                "title": "Projection",
                "type": "string"
              }
            },
            "title": "InterventionQueryInput",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/$defs/InterventionActionInput"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Outcome construct. Defaults to the stage-1a outcome.",
            "title": "Outcome"
          },
          "query": {
            "$ref": "#/$defs/InterventionQueryInput"
          }
        },
        "required": [
          "action"
        ],
        "title": "SimulateInterventionInput",
        "type": "object"
      },
      "result": {
        "$defs": {
          "EffectSummaryContract": {
            "additionalProperties": false,
            "properties": {
              "mean": {
                "title": "Mean",
                "type": "number"
              },
              "median": {
                "title": "Median",
                "type": "number"
              },
              "lower_95": {
                "title": "Lower 95",
                "type": "number"
              },
              "upper_95": {
                "title": "Upper 95",
                "type": "number"
              },
              "prob_positive": {
                "title": "Prob Positive",
                "type": "number"
              }
            },
            "required": [
              "mean",
              "median",
              "lower_95",
              "upper_95",
              "prob_positive"
            ],
            "title": "EffectSummaryContract",
            "type": "object"
          },
          "EffectTrajectoryPointContract": {
            "additionalProperties": false,
            "properties": {
              "day": {
                "title": "Day",
                "type": "number"
              },
              "effect": {
                "title": "Effect",
                "type": "number"
              }
            },
            "required": [
              "day",
              "effect"
            ],
            "title": "EffectTrajectoryPointContract",
            "type": "object"
          },
          "InterventionActionInput": {
            "additionalProperties": false,
            "properties": {
              "variable": {
                "description": "Latent construct to intervene on.",
                "title": "Variable",
                "type": "string"
              },
              "mode": {
                "description": "'set' clamps the construct to a value; 'shift' adds an amount to baseline.",
                "enum": [
                  "set",
                  "shift"
                ],
                "title": "Mode",
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Required when mode='set'. Absolute latent-space value to clamp to.",
                "title": "Value"
              },
              "amount": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Required when mode='shift'. Additive latent-space delta from baseline.",
                "title": "Amount"
              }
            },
            "required": [
              "variable",
              "mode"
            ],
            "title": "InterventionActionInput",
            "type": "object"
          },
          "SimulateInterventionResultContract": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "$ref": "#/$defs/InterventionActionInput"
              },
              "outcome": {
                "title": "Outcome",
                "type": "string"
              },
              "summary": {
                "$ref": "#/$defs/EffectSummaryContract"
              },
              "effect_trajectory": {
                "anyOf": [
                  {
                    "items": {
                      "$ref": "#/$defs/EffectTrajectoryPointContract"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Effect Trajectory"
              },
              "visualization": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Stage6VisualizationContract"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "manifest_effects": {
                "anyOf": [
                  {
                    "additionalProperties": {
                      "type": "number"
                    },
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Manifest Effects"
              },
              "warnings": {
                "items": {
                  "type": "string"
                },
                "title": "Warnings",
                "type": "array"
              },
              "rung": {
                "const": 2,
                "title": "Rung",
                "type": "integer"
              },
              "estimand": {
                "enum": [
                  "steady_state",
                  "trajectory"
                ],
                "title": "Estimand",
                "type": "string"
              },
              "baseline_treatment_mean": {
                "title": "Baseline Treatment Mean",
                "type": "number"
              }
            },
            "required": [
              "action",
              "outcome",
              "summary",
              "rung",
              "estimand",
              "baseline_treatment_mean"
            ],
            "title": "SimulateInterventionResultContract",
            "type": "object"
          },
          "Stage6VisualizationContract": {
            "additionalProperties": false,
            "properties": {
              "node_effect_trajectories": {
                "anyOf": [
                  {
                    "additionalProperties": {
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    },
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Per-construct latent effect trajectories aligned to effect_trajectory days. Values are causal deltas relative to the relevant reference path.",
                "title": "Node Effect Trajectories"
              },
              "abducted_state": {
                "anyOf": [
                  {
                    "additionalProperties": {
                      "type": "number"
                    },
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Recovered latent state at the evidence boundary for rung-3 queries.",
                "title": "Abducted State"
              }
            },
            "title": "Stage6VisualizationContract",
            "type": "object"
          },
          "ToolErrorContract": {
            "additionalProperties": false,
            "properties": {
              "error": {
                "title": "Error",
                "type": "string"
              },
              "identifiable_treatments": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Identifiable Treatments"
              }
            },
            "required": [
              "error"
            ],
            "title": "ToolErrorContract",
            "type": "object"
          }
        },
        "anyOf": [
          {
            "$ref": "#/$defs/SimulateInterventionResultContract"
          },
          {
            "$ref": "#/$defs/ToolErrorContract"
          }
        ],
        "title": "SimulateInterventionToolResultContract"
      }
    },
    {
      "name": "simulate_counterfactual",
      "description": "Run a Pearl rung-3 counterfactual forecast by conditioning on an observed history window, then applying an action.",
      "parameters": {
        "$defs": {
          "CounterfactualEvidenceInput": {
            "additionalProperties": false,
            "properties": {
              "start_time": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Inclusive ISO-8601 lower bound for the evidence window.",
                "title": "Start Time"
              },
              "end_time": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Inclusive ISO-8601 upper bound for the evidence window. Defaults to the final observed time.",
                "title": "End Time"
              },
              "variables": {
                "description": "Optional constructs or indicators to highlight when describing evidence coverage.",
                "items": {
                  "type": "string"
                },
                "title": "Variables",
                "type": "array"
              }
            },
            "title": "CounterfactualEvidenceInput",
            "type": "object"
          },
          "CounterfactualQueryInput": {
            "additionalProperties": false,
            "properties": {
              "estimand": {
                "default": "end_state",
                "description": "Compare the final forecasted outcome or the full effect trajectory.",
                "enum": [
                  "end_state",
                  "trajectory"
                ],
                "title": "Estimand",
                "type": "string"
              },
              "horizon_days": {
                "default": 30,
                "description": "Forward horizon in days for the counterfactual forecast.",
                "maximum": 365,
                "minimum": 1,
                "title": "Horizon Days",
                "type": "integer"
              },
              "projection": {
                "default": "latent",
                "description": "Whether to report latent outcome effects, manifest projections, or both.",
                "enum": [
                  "latent",
                  "manifest",
                  "both"
                ],
                "title": "Projection",
                "type": "string"
              }
            },
            "title": "CounterfactualQueryInput",
            "type": "object"
          },
          "InterventionActionInput": {
            "additionalProperties": false,
            "properties": {
              "variable": {
                "description": "Latent construct to intervene on.",
                "title": "Variable",
                "type": "string"
              },
              "mode": {
                "description": "'set' clamps the construct to a value; 'shift' adds an amount to baseline.",
                "enum": [
                  "set",
                  "shift"
                ],
                "title": "Mode",
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Required when mode='set'. Absolute latent-space value to clamp to.",
                "title": "Value"
              },
              "amount": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Required when mode='shift'. Additive latent-space delta from baseline.",
                "title": "Amount"
              }
            },
            "required": [
              "variable",
              "mode"
            ],
            "title": "InterventionActionInput",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "$ref": "#/$defs/CounterfactualEvidenceInput"
          },
          "action": {
            "$ref": "#/$defs/InterventionActionInput"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Outcome construct. Defaults to the stage-1a outcome.",
            "title": "Outcome"
          },
          "query": {
            "$ref": "#/$defs/CounterfactualQueryInput"
          }
        },
        "required": [
          "action"
        ],
        "title": "SimulateCounterfactualInput",
        "type": "object"
      },
      "result": {
        "$defs": {
          "CounterfactualEvidenceResultContract": {
            "additionalProperties": false,
            "properties": {
              "start_time": {
                "title": "Start Time",
                "type": "string"
              },
              "end_time": {
                "title": "End Time",
                "type": "string"
              },
              "n_timepoints": {
                "title": "N Timepoints",
                "type": "integer"
              },
              "variables": {
                "items": {
                  "type": "string"
                },
                "title": "Variables",
                "type": "array"
              },
              "conditioning_method": {
                "title": "Conditioning Method",
                "type": "string"
              }
            },
            "required": [
              "start_time",
              "end_time",
              "n_timepoints",
              "conditioning_method"
            ],
            "title": "CounterfactualEvidenceResultContract",
            "type": "object"
          },
          "EffectSummaryContract": {
            "additionalProperties": false,
            "properties": {
              "mean": {
                "title": "Mean",
                "type": "number"
              },
              "median": {
                "title": "Median",
                "type": "number"
              },
              "lower_95": {
                "title": "Lower 95",
                "type": "number"
              },
              "upper_95": {
                "title": "Upper 95",
                "type": "number"
              },
              "prob_positive": {
                "title": "Prob Positive",
                "type": "number"
              }
            },
            "required": [
              "mean",
              "median",
              "lower_95",
              "upper_95",
              "prob_positive"
            ],
            "title": "EffectSummaryContract",
            "type": "object"
          },
          "EffectTrajectoryPointContract": {
            "additionalProperties": false,
            "properties": {
              "day": {
                "title": "Day",
                "type": "number"
              },
              "effect": {
                "title": "Effect",
                "type": "number"
              }
            },
            "required": [
              "day",
              "effect"
            ],
            "title": "EffectTrajectoryPointContract",
            "type": "object"
          },
          "InterventionActionInput": {
            "additionalProperties": false,
            "properties": {
              "variable": {
                "description": "Latent construct to intervene on.",
                "title": "Variable",
                "type": "string"
              },
              "mode": {
                "description": "'set' clamps the construct to a value; 'shift' adds an amount to baseline.",
                "enum": [
                  "set",
                  "shift"
                ],
                "title": "Mode",
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Required when mode='set'. Absolute latent-space value to clamp to.",
                "title": "Value"
              },
              "amount": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Required when mode='shift'. Additive latent-space delta from baseline.",
                "title": "Amount"
              }
            },
            "required": [
              "variable",
              "mode"
            ],
            "title": "InterventionActionInput",
            "type": "object"
          },
          "SimulateCounterfactualResultContract": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "$ref": "#/$defs/InterventionActionInput"
              },
              "outcome": {
                "title": "Outcome",
                "type": "string"
              },
              "summary": {
                "$ref": "#/$defs/EffectSummaryContract"
              },
              "effect_trajectory": {
                "anyOf": [
                  {
                    "items": {
                      "$ref": "#/$defs/EffectTrajectoryPointContract"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Effect Trajectory"
              },
              "visualization": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Stage6VisualizationContract"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "manifest_effects": {
                "anyOf": [
                  {
                    "additionalProperties": {
                      "type": "number"
                    },
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Manifest Effects"
              },
              "warnings": {
                "items": {
                  "type": "string"
                },
                "title": "Warnings",
                "type": "array"
              },
              "rung": {
                "const": 3,
                "title": "Rung",
                "type": "integer"
              },
              "evidence": {
                "$ref": "#/$defs/CounterfactualEvidenceResultContract"
              },
              "estimand": {
                "enum": [
                  "end_state",
                  "trajectory"
                ],
                "title": "Estimand",
                "type": "string"
              },
              "baseline_forecast_mean": {
                "title": "Baseline Forecast Mean",
                "type": "number"
              }
            },
            "required": [
              "action",
              "outcome",
