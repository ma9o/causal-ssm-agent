                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Required when mode='shift'. Additive latent-space delta from baseline.",
                "title": "Amount"
              }
            },
            "required": [
              "variable",
              "mode"
            ],
            "title": "InterventionActionInput",
            "type": "object"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
