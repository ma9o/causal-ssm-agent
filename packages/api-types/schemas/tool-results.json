{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CausalSSMToolResults",
  "description": "Combined JSON Schema for declared tool result contracts.",
  "anyOf": [
    {
      "$ref": "#/$defs/ToolErrorContract"
    },
    {
      "$ref": "#/$defs/EffectSummaryContract"
    },
    {
      "$ref": "#/$defs/EffectTrajectoryPointContract"
    },
    {
      "$ref": "#/$defs/Stage6VisualizationContract"
    },
    {
      "$ref": "#/$defs/CounterfactualEvidenceResultContract"
    },
    {
      "$ref": "#/$defs/SimulateInterventionResultContract"
    },
    {
      "$ref": "#/$defs/SimulateCounterfactualResultContract"
    },
    {
      "$ref": "#/$defs/SimulateInterventionToolResultContract"
    },
    {
      "$ref": "#/$defs/SimulateCounterfactualToolResultContract"
    }
  ],
  "$defs": {
    "CounterfactualEvidenceResultContract": {
      "additionalProperties": false,
      "properties": {
        "start_time": {
          "title": "Start Time",
          "type": "string"
        },
        "end_time": {
          "title": "End Time",
          "type": "string"
        },
        "n_timepoints": {
          "title": "N Timepoints",
          "type": "integer"
        },
        "variables": {
          "items": {
            "type": "string"
          },
          "title": "Variables",
          "type": "array"
        },
        "conditioning_method": {
          "title": "Conditioning Method",
          "type": "string"
        }
      },
      "required": [
        "conditioning_method",
        "end_time",
        "n_timepoints",
        "start_time",
        "variables"
      ],
      "title": "CounterfactualEvidenceResultContract",
      "type": "object"
    },
    "EffectSummaryContract": {
      "additionalProperties": false,
      "properties": {
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "median": {
          "title": "Median",
          "type": "number"
        },
        "lower_95": {
          "title": "Lower 95",
          "type": "number"
        },
        "upper_95": {
          "title": "Upper 95",
          "type": "number"
        },
        "prob_positive": {
          "title": "Prob Positive",
          "type": "number"
        }
      },
      "required": [
        "lower_95",
        "mean",
        "median",
        "prob_positive",
        "upper_95"
      ],
      "title": "EffectSummaryContract",
      "type": "object"
    },
    "EffectTrajectoryPointContract": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "title": "Day",
          "type": "number"
        },
        "effect": {
          "title": "Effect",
          "type": "number"
        }
      },
      "required": [
        "day",
        "effect"
      ],
      "title": "EffectTrajectoryPointContract",
      "type": "object"
    },
    "InterventionActionInput": {
      "additionalProperties": false,
      "properties": {
        "variable": {
          "description": "Latent construct to intervene on.",
          "title": "Variable",
          "type": "string"
        },
        "mode": {
          "description": "'set' clamps the construct to a value; 'shift' adds an amount to baseline.",
          "enum": [
            "set",
            "shift"
          ],
          "title": "Mode",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required when mode='set'. Absolute latent-space value to clamp to.",
          "title": "Value"
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required when mode='shift'. Additive latent-space delta from baseline.",
          "title": "Amount"
        }
      },
      "required": [
        "mode",
        "variable"
      ],
      "title": "InterventionActionInput",
      "type": "object"
    },
    "SimulateCounterfactualResultContract": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/InterventionActionInput"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/EffectSummaryContract"
        },
        "effect_trajectory": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/EffectTrajectoryPointContract"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Trajectory"
        },
        "visualization": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stage6VisualizationContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manifest_effects": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Effects"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "rung": {
          "const": 3,
          "title": "Rung",
          "type": "integer"
        },
        "evidence": {
          "$ref": "#/$defs/CounterfactualEvidenceResultContract"
        },
        "estimand": {
          "enum": [
            "end_state",
            "trajectory"
          ],
          "title": "Estimand",
          "type": "string"
        },
        "baseline_forecast_mean": {
          "title": "Baseline Forecast Mean",
          "type": "number"
        }
      },
      "required": [
        "action",
        "baseline_forecast_mean",
        "estimand",
        "evidence",
        "outcome",
        "rung",
        "summary",
        "warnings"
      ],
      "title": "SimulateCounterfactualResultContract",
      "type": "object"
    },
    "SimulateCounterfactualToolResultContract": {
      "anyOf": [
        {
          "$ref": "#/$defs/SimulateCounterfactualResultContract"
        },
        {
          "$ref": "#/$defs/ToolErrorContract"
        }
      ],
      "title": "SimulateCounterfactualToolResultContract"
    },
    "SimulateInterventionResultContract": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/InterventionActionInput"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/EffectSummaryContract"
        },
        "effect_trajectory": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/EffectTrajectoryPointContract"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Trajectory"
        },
        "visualization": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stage6VisualizationContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manifest_effects": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Effects"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "rung": {
          "const": 2,
          "title": "Rung",
          "type": "integer"
        },
        "estimand": {
          "enum": [
            "steady_state",
            "trajectory"
          ],
          "title": "Estimand",
          "type": "string"
        },
        "baseline_treatment_mean": {
          "title": "Baseline Treatment Mean",
          "type": "number"
        }
      },
      "required": [
        "action",
        "baseline_treatment_mean",
        "estimand",
        "outcome",
        "rung",
        "summary",
        "warnings"
      ],
      "title": "SimulateInterventionResultContract",
      "type": "object"
    },
    "SimulateInterventionToolResultContract": {
      "anyOf": [
        {
          "$ref": "#/$defs/SimulateInterventionResultContract"
        },
        {
          "$ref": "#/$defs/ToolErrorContract"
        }
      ],
      "title": "SimulateInterventionToolResultContract"
    },
    "Stage6VisualizationContract": {
      "additionalProperties": false,
      "properties": {
        "node_effect_trajectories": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-construct latent effect trajectories aligned to effect_trajectory days. Values are causal deltas relative to the relevant reference path.",
          "title": "Node Effect Trajectories"
        },
        "abducted_state": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recovered latent state at the evidence boundary for rung-3 queries.",
          "title": "Abducted State"
        }
      },
      "title": "Stage6VisualizationContract",
      "type": "object"
    },
    "ToolErrorContract": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "title": "Error",
          "type": "string"
        },
        "identifiable_treatments": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifiable Treatments"
        }
      },
      "required": [
        "error"
      ],
      "title": "ToolErrorContract",
      "type": "object"
    }
  }
}
