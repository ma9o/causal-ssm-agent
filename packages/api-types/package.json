{
  "name": "@nof1-causal-lab/api-types",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "codegen:contracts:json": "uv run --directory ../../apps/data-pipeline python scripts/export_schemas.py",
    "codegen:contracts:typescript": "bun run scripts/generate.ts",
    "codegen:contracts": "bun run codegen:contracts:json && bun run codegen:contracts:typescript",
    "codegen:agent-api": "uv run --directory ../../apps/data-pipeline python scripts/export_agent_api.py",
    "codegen": "bun run --parallel --no-exit-on-error codegen:contracts codegen:agent-api",
    "codegen:check:contracts-json": "uv run --directory ../../apps/data-pipeline python scripts/export_schemas.py --check",
    "codegen:check:contracts-typescript": "bun run scripts/generate.ts --check",
    "codegen:check:agent-api": "uv run --directory ../../apps/data-pipeline python scripts/export_agent_api.py --check",
    "codegen:check": "bun run --parallel --no-exit-on-error codegen:check:contracts-json codegen:check:contracts-typescript codegen:check:agent-api",
    "check": "bun run --parallel --no-exit-on-error codegen:check lint type-check"
  },
  "devDependencies": {
    "@nof1-causal-lab/typescript-config": "workspace:*",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5"
  }
}
