{
  "name": "nof1-causal-lab",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "turbo dev",
    "build": "turbo build",
    "codegen": "bun run --cwd packages/api-types codegen",
    "codegen:check": "bun run --cwd packages/api-types codegen:check",
    "docs:codegen:distribution": "bun run --cwd apps/data-pipeline codegen:docs",
    "docs:codegen:latex": "bun scripts/codegen_docs_latex.js",
    "docs:codegen": "bun run docs:codegen:distribution && bun run docs:codegen:latex",
    "docs:check:distribution": "bun run --cwd apps/data-pipeline codegen:docs:check",
    "docs:check:latex": "bun scripts/codegen_docs_latex.js --check",
    "docs:check:markdown": "markdownlint-cli2 --config .markdownlint-docs.json \"README.md\" \"docs/**/*.md\"",
    "docs:check:spell": "cspell --config cspell.config.json --no-progress --show-suggestions \"README.md\" \"docs/**/*.md\"",
    "docs:check": "bun run --parallel --no-exit-on-error docs:check:distribution docs:check:latex docs:check:markdown docs:check:spell",
    "duplicates": "bun run --cwd apps/data-pipeline duplicates",
    "fixture:check-demo": "PYTHONHASHSEED=0 uv run --project apps/data-pipeline python apps/data-pipeline/scripts/generate_demo_fixture_completion.py --check",
    "fixture:complete-demo": "PYTHONHASHSEED=0 uv run --project apps/data-pipeline python apps/data-pipeline/scripts/generate_demo_fixture_completion.py",
    "fixture:promote": "bun scripts/promote-data-to-fixture.ts",
    "integration:start": "bash scripts/start_agentic_integration_stack.sh",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "knip": "knip --production",
    "test": "bun run test:fixture-promotion && turbo test",
    "test:all": "turbo test:all",
    "test:fixture-promotion": "bun test scripts/promote-data-to-fixture.test.ts",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "type-check": "turbo type-check",
    "check": "bun run test:fixture-promotion && turbo run lint type-check test build codegen:check docs:check knip --continue=always",
    "storybook": "turbo storybook"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.1",
    "cspell": "^10.0.0",
    "jscpd": "5.0.15",
    "knip": "^6.20.0",
    "markdownlint-cli2": "^0.23.2",
    "mathjax-full": "3.2.2",
    "turbo": "^2"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
