{
  "name": "nof1-causal-lab",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "bun@1.2.23",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "turbo dev",
    "build": "turbo build",
    "docs:codegen": "bun run --cwd packages/api-types codegen && bun scripts/codegen_docs_latex.js",
    "docs:spell": "cspell --config cspell.config.json --no-progress --show-suggestions \"README.md\" \"docs/**/*.md\"",
    "docs:check": "cd apps/data-pipeline && uv run python scripts/export_distribution_docs.py --check && cd ../.. && bun run --cwd packages/api-types codegen:check && bun scripts/codegen_docs_latex.js --check && markdownlint-cli2 --config .markdownlint-docs.json \"README.md\" \"docs/**/*.md\" && bun run docs:spell",
    "integration:start": "bash scripts/start_agentic_integration_stack.sh",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "knip": "knip --production",
    "test": "turbo test",
    "test:all": "turbo test:all",
    "format": "turbo format",
    "type-check": "turbo type-check",
    "check": "turbo run check docs:check knip",
    "storybook": "turbo storybook"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.0",
    "cspell": "^10.0.0",
    "knip": "^6.20.0",
    "markdownlint-cli2": "^0.23.2",
    "mathjax-full": "3.2.2",
    "turbo": "^2"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
