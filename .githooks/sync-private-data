#!/usr/bin/env bash
# Syncs symlinks in data/ for every top-level directory in the .private submodule.
# Called by post-checkout and post-merge hooks.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PRIVATE_DIR="$REPO_ROOT/data/.private"
DATA_DIR="$REPO_ROOT/data"

# Nothing to do if the submodule isn't checked out
[ -d "$PRIVATE_DIR" ] || exit 0

for dir in "$PRIVATE_DIR"/*/; do
    [ -d "$dir" ] || continue
    name="$(basename "$dir")"
    link="$DATA_DIR/$name"

    # Skip if a correct symlink already exists
    if [ -L "$link" ] && [ "$(readlink "$link")" = ".private/$name" ]; then
        continue
    fi

    # Warn if something non-symlink is in the way
    if [ -e "$link" ] && [ ! -L "$link" ]; then
        echo "sync-private-data: WARNING — $link exists and is not a symlink, skipping"
        continue
    fi

    ln -sf ".private/$name" "$link"
    echo "sync-private-data: created symlink data/$name → .private/$name"
done
