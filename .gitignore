scratchpad/**

repomix-output.xml

# Streamlit component artifacts
/lib/

# Marimo session artifacts
__marimo__/

# Node / Turborepo
node_modules/
.next/
.turbo/

# Always track gitkeeps (must be last to override above patterns)
!**/.gitkeep
